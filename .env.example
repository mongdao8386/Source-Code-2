# ─────────────────────────────────────────────────────────────
# Copy to .env (local) or set on the VPS. NEVER commit real values.
# ─────────────────────────────────────────────────────────────

# Public site origin, no trailing slash (e.g. https://studio.example.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=vi

# ── Supabase (Project Settings → API) ────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Full DB access, bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Direct Postgres connection string, used by migrations + backups only.
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres
# Supabase CLI personal access token, used by `supabase db push` in CI.
SUPABASE_ACCESS_TOKEN=

# ── First owner (used once by scripts/seed-owner.ts) ─────────
OWNER_EMAIL=owner@example.com
OWNER_INITIAL_PASSWORD=change-me-immediately-after-first-login
OWNER_FULL_NAME=Studio Owner

# ── Rate limiting ───────────────────────────────────────────
# In Docker Compose this points at the bundled redis service.
REDIS_URL=redis://redis:6379
# login attempts / window(seconds)
RATE_LIMIT_LOGIN=5/600

# ── Outbound email for admin invitations ────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Studio <no-reply@example.com>"

# ── Deployment (Caddy) ──────────────────────────────────────
# Domain Caddy will request a certificate for. Set on the VPS.
SITE_DOMAIN=studio.example.com
ACME_EMAIL=admin@example.com
